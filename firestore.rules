rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "infozedscoreteam@gmail.com" && request.auth.token.email_verified == true);
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidThumbnail(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             data.imageUrl is string && data.imageUrl.size() > 0 &&
             data.createdAt is timestamp;
    }

    function isValidHeroThumbnail(data) {
      return data.url is string && data.url.size() > 0 &&
             (!('rotate' in data) || data.rotate is number) &&
             (!('x' in data) || data.x is number) &&
             (!('y' in data) || data.y is number) &&
             data.createdAt is timestamp;
    }

    function isValidRandomPost(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             (!('desc' in data) || data.desc is string) &&
             data.image is string && data.image.size() > 0 &&
             (!('rotate' in data) || data.rotate is number) &&
             (!('y' in data) || data.y is number) &&
             data.createdAt is timestamp;
    }

    function isValidBTS(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.imageUrl is string && data.imageUrl.size() > 0 &&
             (!('videoTitle' in data) || data.videoTitle is string) &&
             (!('description' in data) || data.description is string) &&
             (!('layoutIdea' in data) || data.layoutIdea is string) &&
             (!('designWorkflow' in data) || data.designWorkflow is string) &&
             (!('caseStudy' in data) || data.caseStudy is string) &&
             (!('clientFeedback' in data) || data.clientFeedback is string) &&
             (!('whatsappChat' in data) || data.whatsappChat is list) &&
             (!('beforeImages' in data) || data.beforeImages is list) &&
             (!('afterImages' in data) || data.afterImages is list) &&
             data.createdAt is timestamp;
    }

    function isValidUser(data) {
      return data.uid is string && data.uid == request.auth.uid &&
             data.email is string && 
             (data.role == 'admin' || data.role == 'client') &&
             data.createdAt is timestamp;
    }

    // Rules
    match /thumbnails/{id} {
      allow read: if true;
      allow create: if isAdmin() && isValidThumbnail(request.resource.data);
      allow update: if isAdmin() && isValidThumbnail(request.resource.data);
      allow delete: if isAdmin();
    }

    match /hero_thumbnails/{id} {
      allow read: if true;
      allow create: if isAdmin() && isValidHeroThumbnail(request.resource.data);
      allow update: if isAdmin() && isValidHeroThumbnail(request.resource.data);
      allow delete: if isAdmin();
    }

    match /random_posts/{id} {
      allow read: if true;
      allow create: if isAdmin() && isValidRandomPost(request.resource.data);
      allow update: if isAdmin() && isValidRandomPost(request.resource.data);
      allow delete: if isAdmin();
    }

    match /behind_the_scenes/{id} {
      allow read: if true;
      allow create: if isAdmin() && isValidBTS(request.resource.data);
      allow update: if isAdmin() && isValidBTS(request.resource.data);
      allow delete: if isAdmin();
    }

    match /users/{id} {
      allow read: if isAuthenticated() && (isOwner(id) || isAdmin());
      allow create: if isAuthenticated() && isOwner(id) && isValidUser(request.resource.data);
      allow update: if isAuthenticated() && isOwner(id) && isValidUser(request.resource.data);
      allow delete: if isAdmin();
    }

    match /test/{id} {
      allow read: if true;
    }
  }
}
